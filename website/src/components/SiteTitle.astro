---
import logoDark from '../assets/logo-dark.png';
import logoLight from '../assets/logo-light.png';
---

<div class="site-title">
	<div class="brand-lockup">
		<a class="logo" href="/" aria-label="SQLClean home">
			<img class="logo-for-light" src={logoLight.src} alt="SQLClean" width={133} height={30} />
			<img class="logo-for-dark" src={logoDark.src} alt="SQLClean" width={133} height={30} />
		</a>
		<a class="brand-byline" href="https://sqlstack.io">by SQLStack</a>
	</div>
	<a class="docs" href="/docs/">Docs</a>
</div>

<style>
	.site-title {
		display: flex;
		flex-shrink: 0;
		align-items: center;
		gap: 12px;
		min-width: 0;
	}

	.brand-lockup {
		display: flex;
		flex-direction: column;
	}

	.brand-byline {
		display: flex;
		align-items: center;
		min-height: 24px;
		margin-inline-start: 30%;
		color: var(--sqc-muted);
		font-size: 11px;
		line-height: 14px;
		text-decoration: none;
		white-space: nowrap;
	}

	.brand-byline:hover {
		color: var(--sqc-primary);
	}

	.logo {
		display: flex;
	}

	img {
		width: auto;
		height: 30px;
	}

	.logo-for-dark,
	:global(:root[data-theme='dark']) .logo-for-light {
		display: none;
	}

	:global(:root[data-theme='dark']) .logo-for-dark {
		display: block;
	}

	.docs {
		padding: 2px 6px;
		border: 1px solid var(--sqc-line-strong);
		border-radius: 2px;
		color: var(--sqc-muted);
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.06em;
		line-height: 1.4;
		text-transform: uppercase;
		text-decoration: none;
	}

	.docs:hover {
		border-color: var(--sqc-primary);
		color: var(--sqc-primary);
	}
</style>
